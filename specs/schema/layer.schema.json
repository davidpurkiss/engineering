{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/davidpurkiss/engineering/main/specs/schema/layer.schema.json",
  "title": "Layer",
  "description": "A reusable architectural layer. Architectures compose layers by id; layers never reference architectures.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "purpose", "type", "responsibilities", "restrictions", "dependencies"],
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "description": "Kebab-case. Must equal the filename without .json."
    },
    "name": { "type": "string", "minLength": 1 },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "description": "One sentence. What this layer is for."
    },
    "type": {
      "enum": ["presentation", "business", "data", "processing", "infrastructure", "utility"],
      "description": "Broad role. Used to reason about compatibility, not to enforce it."
    },
    "responsibilities": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "restrictions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "What this layer must NOT do. Required and non-empty by design: the boundary is the load-bearing part of a layer definition."
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canImport", "cannotImport"],
      "properties": {
        "canImport": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Layer ids or free-form module tags this layer may import."
        },
        "cannotImport": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Explicit denials. Compiled into import-boundary checks."
        }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "methods": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pattern", "returnType"],
            "properties": {
              "pattern": { "type": "string", "description": "Name pattern, e.g. get{Resource}ById" },
              "parameters": { "type": "string" },
              "returnType": { "type": "string" },
              "async": { "type": "boolean", "default": true }
            }
          }
        },
        "errorHandling": { "type": "string" }
      }
    },
    "conventions": {
      "type": "object",
      "description": "Named conventions this layer follows.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pattern", "description"],
        "properties": {
          "pattern": { "type": "string" },
          "description": { "type": "string" },
          "example": { "type": "string" }
        }
      }
    },
    "agentHints": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Short instructions for an agent generating or reviewing code in this layer."
    }
  }
}
