{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/davidpurkiss/engineering/main/specs/schema/ruleset.schema.json",
  "title": "Ruleset",
  "description": "A named collection of addressable rules. Rules carry an id so a review finding can cite one rather than paraphrase it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "description", "rules"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
    "description": { "type": "string", "minLength": 1 },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "rule", "severity", "category"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
          "description": "Unique across all rulesets. This is what a finding cites."
        },
        "scope": {
          "type": "string",
          "description": "A layer id, or * for every layer."
        },
        "rule": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["error", "warning", "info"] },
        "category": {
          "enum": ["dependency", "error-handling", "security", "testing", "code-quality", "documentation", "observability", "naming"]
        },
        "rationale": {
          "type": "string",
          "description": "Why. Optional, but a rule nobody can justify is a rule nobody will keep."
        },
        "check": {
          "$ref": "#/$defs/check",
          "description": "Present only when the rule is mechanically enforceable. Absence means human judgement."
        }
      }
    },
    "check": {
      "type": "object",
      "required": ["kind"],
      "oneOf": [{ "$ref": "#/$defs/importBoundary" }]
    },
    "importBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "from", "denyImportsFrom"],
      "properties": {
        "kind": { "const": "import-boundary" },
        "from": { "type": "string", "description": "Layer id the restriction applies to." },
        "denyImportsFrom": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Layer ids or module tags that must not be imported."
        }
      }
    }
  }
}
